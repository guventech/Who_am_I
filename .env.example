# Copy to .env.local for local overrides.
# Defaults: ALLOW_* true outside production, false in production.
# Never commit real secret values.

# NODE_ENV=development
# ALLOW_UNCALIBRATED=true
# ALLOW_DRAFT_CONTENT=true

# Optional go-deeper (off in production unless explicitly true)
# ENABLE_GO_DEEPER=false
# NEXT_PUBLIC_ENABLE_GO_DEEPER=false

# Durable storage (server-only). All three required in production.
# Generate secrets with: openssl rand -hex 32
# CONVEX_URL=
# CONVEX_SERVER_KEY=
# SESSION_CODE_PEPPER=
# RATE_LIMIT_SALT=

# Optional: only if the Vercel build runs `npx convex deploy --cmd 'pnpm build'`
# CONVEX_DEPLOY_KEY=

# Set CONVEX_SERVER_KEY to the same value in the Convex dashboard env.
# One-time: npx convex deploy, set Convex + Vercel vars, redeploy.
