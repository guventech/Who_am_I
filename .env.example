# Copy to .env.local for local overrides.
# Defaults: ALLOW_* true outside production, false in production.

# NODE_ENV=development
# ALLOW_UNCALIBRATED=true
# ALLOW_DRAFT_CONTENT=true

# Convex (optional). Until set, /api/storage uses in-memory store for local/e2e.
# Confirm EU region before production (brief §14).
# CONVEX_URL=
# NEXT_PUBLIC_CONVEX_URL=
