# The quiz does not save new answers or results on the server.
# Explicit prototype build flags:
# ALLOW_UNCALIBRATED=true
# ALLOW_DRAFT_CONTENT=true

# Existing optional deeper analysis; off in production by default:
# NEXT_PUBLIC_ENABLE_GO_DEEPER=false

# Legacy deletion only: preserve existing values for previously saved records.
# These are server-only. Never commit real secrets.
# CONVEX_URL=
# CONVEX_SERVER_KEY=
# SESSION_CODE_PEPPER=
